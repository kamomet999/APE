{
  "name": "ape",
  "version": "0.1.0",
  "private": true,
  "description": "APE (Agri-Tech Planning Engine) - Agricultural Management Platform",
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@ape/mobile",
    "dev:web": "turbo run dev --filter=@ape/web",
    "dev:worker": "turbo run dev --filter=@ape/worker-app",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "typecheck": "turbo run typecheck",
    "validate": "node scripts/dev/check-env.js",
    "test:e2e": "playwright install && playwright test",
    "validate:all": "npm run build && npm run validate && npm run test:e2e",
    "seed:demo": "tsx scripts/seed-demo-data.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@supabase/supabase-js": "^2.118.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "postcss-selector-parser": ">=7.1.6",
      "picomatch": ">=2.3.2",
      "nanoid": ">=3.3.18",
      "browserslist": ">=4.28.7",
      "baseline-browser-mapping": ">=2.11.0",
      "source-map-js": ">=1.2.2",
      "yaml": ">=2.8.3"
    }
  }
}
